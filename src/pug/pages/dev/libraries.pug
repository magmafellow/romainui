extends ../../layouts/base



block content
  main.container.pt-base.pb-base
    div.flex.flex-col.gap-10
      div.dev-info
        p Project Stack. JavaScript libraries used throughout the project


      div.flex.flex-col.gap-6
        div.typo-h3-desktop GSAP (JS-based animations)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://gsap.com/docs/v3/">Docs</a>
          p Used to create fancy animations

      div.flex.flex-col.gap-6
        div.typo-h3-desktop Swiper (Carousel)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://swiperjs.com/">Docs</a>
          p Used to create sliders (carousels) throughout the project

      div.flex.flex-col.gap-6
        div.typo-h3-desktop Toastify (Toasts)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://github.com/apvarun/toastify-js">Docs</a>
          p Used to show error message in Drop n Drag when attaching resume files (on /contacts.html)

      div.flex.flex-col.gap-6
        div.typo-h3-desktop Vanilla Calendar Pro (Calendar)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://vanilla-calendar.pro/">Docs</a>
          p Used to create calendars on site

      div.flex.flex-col.gap-6
        div.typo-h3-desktop Tippy (popovers, tooltips)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://atomiks.github.io/tippyjs/">Docs</a>
          p <b>Important</b> library. Used to create dropdowns, tooltips, popovers

      div.flex.flex-col.gap-6
        div.typo-h3-desktop Pristine (form validation)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://pristine.js.org/">Docs</a>
          p Library used to validate forms

      div.flex.flex-col.gap-6
        div.typo-h3-desktop NOUISlider (range slider)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://refreshless.com/nouislider/">Docs</a>
          p Library used to create range sliders

      div.flex.flex-col.gap-6
        div.typo-h3-desktop wnumb (number formatting)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://refreshless.com/wnumb/">Docs</a>
          p Utility library. Primarily used in pair with NOUISlider for number formatting (+ can be used for money formatting)

      div.flex.flex-col.gap-6
        div.typo-h3-desktop Choices-js (Select component)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://github.com/Choices-js/Choices">Docs</a>
          p Library used to create select component

      div.flex.flex-col.gap-6
        div.typo-h3-desktop A11y Dialog (dialogs)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://a11y-dialog.netlify.app/">Docs</a>
          p Library used to create dialogs

      div.flex.flex-col.gap-6
        div.typo-h3-desktop Imask (Input masks)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://imask.js.org/">Docs</a>
          p Library used to create input masks on input elements

      div.flex.flex-col.gap-6
        div.typo-h3-desktop Fancybox
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://fancyapps.com/fancybox/">Docs</a>
          p Library used to create carousels for product page (e.g. on /electro-product.html or /physical-product.html)

      div.flex.flex-col.gap-6
        div.typo-h3-desktop michu2k/Accordion (Accordion)
        div.flex.flex-col.gap-4
          p <a target="_blank" class="text-sky-600 underline decoration-2 hover:decoration-3" href="https://github.com/michu2k/Accordion">Docs</a>
          p Library used to create accordions
